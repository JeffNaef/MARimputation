X.NA<-X
X.NA[M==1]<-NA
colnames(X)<-NULL
colnames(X)<-paste0("X",1:d)
colnames(X.NA)<-paste0("X",1:d)
n<-nrow(X)
x<-X.NA[!is.na(X.NA[,1]),1]
# Define the theoretical density function
f_theoretical <- function(x1) {
return(2 * (7 + x1) / 15)
}
# Create the plot
hist(x,
probability = TRUE,  # Use probability density scale
breaks = 30,         # Adjust number of bins as needed
main = "Distribution of X₁ | M₁ = 0",
xlab = "x₁",
ylab = "Density",
col = "lightblue",
border = "white")
# Overlay the theoretical density
curve(f_theoretical(x),
from = 0,
to = 1,
add = TRUE,
col = "red",
lwd = 2)
# Add legend
legend("topleft",
legend = c("Empirical", "Theoretical: 2(7+x₁)/15"),
fill = c("lightblue", NA),
border = c("black", NA),
lty = c(NA, 1),
col = c(NA, "red"),
lwd = c(NA, 2))
