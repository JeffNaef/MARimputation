nrep.total<-50
Resultsquantile<-list()
for (s in 1:nrep.total){
set.seed(seeds[s])
# Simulate the Uniform Example.
tmp<-uniformexample(n,d)
X<-tmp$X
X.NA<-tmp$X.NA
################################## imputations #########################################
