hist(x_simulated, probability = TRUE, breaks = 30,
main = "Simulated X₁ | M₁ = 0",
xlab = "x₁", col = "lightgreen", border = "white")
curve(2 * (7 + x) / 15, from = 0, to = 1, add = TRUE, col = "red", lwd = 2)
# Simulate n samples from f(x₁ | M₁ = 0) = 2(7 + x₁)/15
simulate_x1_given_M1_0 <- function(n) {
# Generate uniform random variables
u <- runif(n)
# Apply inverse CDF: q_α = -7 + sqrt(49 + 15α)
x1 <- -7 + sqrt(49 + 15 * u)
return(x1)
}
# Example: Generate 10000 samples
set.seed(123)
